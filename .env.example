# =============================================================================
# Mercora Frontend (Gravity Concepts storefront) — Environment Variables
# =============================================================================
# Copy this file to `.env.local` for local dev, or configure the
# equivalent values in your hosting provider (Vercel project settings)
# for staging/production. Never commit `.env`, `.env.local`, or
# `.env.production` with real values.
#
#   cp .env.example .env.local
# =============================================================================


# -----------------------------------------------------------------------------
# Site / API
# -----------------------------------------------------------------------------

# Public URL of this frontend itself. Used for sitemap generation,
# canonical URLs, and OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the Django backend API this app talks to.
NEXT_PUBLIC_API_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# Auth Cookies
# -----------------------------------------------------------------------------
# Must match the cookie names the Django backend is configured to use
# (SIMPLE_JWT AUTH_COOKIE / AUTH_COOKIE_REFRESH in the backend's
# config/settings.py) and CSRF_COOKIE_NAME.

NEXT_PUBLIC_CSRF_COOKIE_NAME=csrftoken
AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token


# -----------------------------------------------------------------------------
# On-demand ISR Revalidation
# -----------------------------------------------------------------------------
# Shared secret required by POST /api/revalidate. Generate a random
# value (e.g. `openssl rand -hex 32`) and configure the same value on
# whatever triggers revalidation (backend webhook, CI, manual curl).
REVALIDATE_SECRET=


# -----------------------------------------------------------------------------
# Error Monitoring — Sentry (optional)
# -----------------------------------------------------------------------------
# Leave blank to disable entirely; no account needed for local dev.
# Actual error capture (instrumentation.ts / instrumentation-client.ts)
# only needs NEXT_PUBLIC_SENTRY_DSN. The three *_ORG/*_PROJECT/*_AUTH_TOKEN
# vars are only for source-map upload at build time (better stack traces
# in the Sentry UI) — optional, and safe to leave unset.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=


# -----------------------------------------------------------------------------
# Author / Socials (footer, metadata)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_AUTHOR_NAME=Ejidike Simon
NEXT_PUBLIC_AUTHOR_GITHUB=https://github.com/ifeanyiejidike
NEXT_PUBLIC_AUTHOR_LINKEDIN=https://www.linkedin.com/in/ifeanyi-s-ejidike
NEXT_PUBLIC_AUTHOR_TWITTER=@gravityconcept
